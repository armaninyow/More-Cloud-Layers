{
	"schemaVersion": 1,
	"id": "morecloudlayers",
	"version": "${version}",
	"name": "More Cloud Layers",
	"description": "Adds configurable extra layers of clouds above the vanilla cloud layer, with adjustable speed, size, and behavior modes.",
	"authors": [
		"Armaninyow"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/more-cloud-layers",
		"sources": "https://github.com/armaninyow/More-Cloud-Layers",
		"issues": "https://github.com/armaninyow/More-Cloud-Layers/discussions/categories/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/morecloudlayers/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.armaninyow.morecloudlayers.MoreCloudLayers"
		],
		"client": [
			"com.armaninyow.morecloudlayers.MoreCloudLayersClient"
		],
		"modmenu": [
			"com.armaninyow.morecloudlayers.ModMenuIntegration"
		]
	},
	"mixins": [
		"morecloudlayers.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ">=1.21.9 <1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"modmenu": "*",
		"cloth-config": "*"
	}
}